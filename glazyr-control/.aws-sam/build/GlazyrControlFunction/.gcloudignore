# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore

.gcloudignore
.git
.gitignore
__pycache__
*.pyc
*.pyo
*.pyd
.Python
.venv
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
.DS_Store
*.md
tests/
.idea/
.vscode/
